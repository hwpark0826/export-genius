{
  "manifest_version": 3,
  "name": "Export Genius Helper 0.3.43",
  "version": "0.3.43",
  "description": "Small helper to inspect and automate the current Export Genius page.",
  "host_permissions": ["https://dashboard.exportgenius.in/*", "http://127.0.0.1:8765/*"],
  "action": {
    "default_title": "Export Genius Helper 0.3.43",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://dashboard.exportgenius.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
